    double curr_h = 0;
    
    // FIX: Move attempts++ before continue
    int attempts = 0;
    while (attempts < 10) {
        if (odom_lock.take(50)) {
            curr_x = botx; 
            curr_y = boty;
            curr_h = both;
            odom_lock.give();
            break;
        }
        attempts++;  // MOVED HERE - before the delay
        pros::delay(10);
    }
    
    if (attempts >= 10) {
        pros::lcd::print(0, "Cordon: Mutex timeout!");
        return;
    }

    // --- STEP 2: CALCULATE PATH ---
    double difx = target_x - curr_x;
    double dify = target_y - curr_y;

    double drive_distance = std::hypot(difx, dify);
